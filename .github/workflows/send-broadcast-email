name: Trigger Supabase BroadCast Email Function

on:
  schedule:
    - cron: "*/30 * * * *"  # every 30 minutes
  workflow_dispatch:         # Allows manual runs from GitHub Actions UI

jobs:
  trigger-function:
    runs-on: ubuntu-latest

    steps:
      - name: Call Supabase Edge Function
        env:
          SUPABASE_FUNCTION_URL: https://asnkirvhzzpxpcmualwn.supabase.co/functions/v1/send-broadcast-email
          SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
        run: |
          echo "Triggering Supabase function at $SUPABASE_FUNCTION_URL"
          curl -X GET "$SUPABASE_FUNCTION_URL" \
            -H "Authorization: Bearer $SUPABASE_SERVICE_KEY"

