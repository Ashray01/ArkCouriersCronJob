on:
  schedule:
    - cron: "0 8,14 * * *"  
  workflow_dispatch:

jobs:
  send-package-email:
    runs-on: ubuntu-latest
    steps:
      - name: Call sync-new-customers
        env:
          SUPABASE_FUNCTION_URL: https://asnkirvhzzpxpcmualwn.supabase.co/functions/v1/sync-new-customers
          SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
        run: |
          curl -sS -X GET "$SUPABASE_FUNCTION_URL" -H "Authorization: Bearer $SUPABASE_SERVICE_KEY"
